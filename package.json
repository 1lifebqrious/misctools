{
  "name": "misctools",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "build:landing": "node scripts/build-pages-site.mjs",
    "build:pages": "pnpm --filter @misctools/isometric-drawing-tool build:pages && pnpm --filter @misctools/algebra-balance-lab build:pages && pnpm build:landing",
    "test": "pnpm -r test",
    "dev:isometric": "pnpm --filter @misctools/isometric-drawing-tool dev",
    "dev:algebra": "pnpm --filter @misctools/algebra-balance-lab dev",
    "build:isometric": "pnpm --filter @misctools/isometric-drawing-tool build",
    "build:algebra": "pnpm --filter @misctools/algebra-balance-lab build",
    "test:isometric": "pnpm --filter @misctools/isometric-drawing-tool test",
    "test:algebra": "pnpm --filter @misctools/algebra-balance-lab test"
  }
}
